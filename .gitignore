# moon local state
.moon/cache/
.moon/docker/

# direnv local overrides (cluster .envrc files under connect/ are committed)
.envrc.local
connect/**/.envrc.local

# Talos secrets + generated machine configs (PKI)
infrastructure/talos/**/*/secrets.yaml
infrastructure/talos/**/*/generated/

# Cluster client configs (also covered by connect/.gitignore)
connect/**/kubeconfig
connect/**/talosconfig

# OpenTofu / Terraform (local state on workstation — not committed)
**/.terraform/
*.tfstate
*.tfstate.*
.tofu.plan
*.tfvars
!*.tfvars.example
!*.auto.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# CSI SSH private keys (public .pub may be committed if desired)
clusters/prd/platform/iscsi-csi/secrets/

.DS_Store
