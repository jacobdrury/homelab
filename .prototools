moon = "2.6.1"
# renovate: datasource=github-releases depName=opentofu/opentofu
tofu = "1.13.1"
# renovate: datasource=github-releases depName=kubernetes/kubernetes versioning=docker
kubectl = "1.37.1"
# renovate: datasource=github-releases depName=helm/helm
helm = "4.3.0"
# renovate: datasource=github-releases depName=siderolabs/talos
talosctl = "1.12.7"
# renovate: datasource=github-releases depName=derailed/k9s
k9s = "0.51.0"
rust = "1.99.0"

[plugins.tools]
tofu = "https://raw.githubusercontent.com/appthrust/proto-toml-plugins/main/tofu/plugin.toml"
kubectl = "https://raw.githubusercontent.com/trillion-labs/proto-plugins/refs/heads/main/kubectl.toml"
helm = "https://raw.githubusercontent.com/stk0vrfl0w/proto-toml-plugins/main/plugins/helm.toml"
talosctl = "file://./.moon/proto-plugin/talosctl.toml"
k9s = "https://raw.githubusercontent.com/appthrust/proto-toml-plugins/main/k9s/plugin.toml"
