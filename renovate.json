{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "labels": ["dependencies", "renovate"],
  "reviewers": ["jacobdrury"],
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "argocd": {
    "managerFilePatterns": ["/^clusters/.+/application\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^clusters/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "proto plugin tools in .prototools (native proto manager covers built-ins only)",
      "managerFilePatterns": ["/^\\.prototools$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[a-z0-9_-]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Ignore Argo git sources pinned to branch main",
      "matchManagers": ["argocd"],
      "matchCurrentValue": "main",
      "enabled": false
    },
    {
      "description": "Group digest-only image refreshes",
      "matchUpdateTypes": ["digest"],
      "groupName": "container digests"
    },
    {
      "description": "Group GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group linuxserver media images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/lscr\\.io\\/linuxserver\\//"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "linuxserver media"
    }
  ]
}
