# direnv: load when you `cd` into this cluster directory.
# Once: direnv allow

export KUBECONFIG="$(expand_path ./kubeconfig)"
export TALOSCONFIG="$(expand_path ./talosconfig)"

if [[ ! -f "${KUBECONFIG}" ]] || [[ ! -f "${TALOSCONFIG}" ]]; then
  echo "connect: missing kubeconfig/talosconfig — run: CONNECT_CLUSTER=$(basename "$PWD") moon run connect:sync" >&2
fi
